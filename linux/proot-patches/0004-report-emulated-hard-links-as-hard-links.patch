+/**
+ * Emulated hard links, as emulate_link() leaves them behind: @old_path and
+ * @new_path are host paths, and the identities are what the platform left
+ * there -- two inodes holding the same bytes -- instead of the one inode that
+ * two names would have shared.
+ *
+ * The table exists because the copy is a lie the guest can catch.  link(2) is
+ * how shadow(1) locks /etc/group and /etc/shadow and how it *verifies* the
+ * lock: it hard-links /etc/group.<pid> to /etc/group.lock and then requires
+ * stat(/etc/group.<pid>).st_nlink == 2, the count only a real hard link has.
+ * A byte copy is left with one link, so groupadd(8) reads the lock it just
+ * took as already held and exits 10 -- "cannot lock /etc/group; try again
+ * later." -- which fails openssh-client's postinst and with it the whole
+ * apt-get install (a device run was lost to exactly that).  PRoot made the
+ * link, so PRoot answers for it: fix_emulated_link_stat() and
+ * fix_emulated_link_statx() report the group's own inode and its number of
+ * names for as long as the pair is still the pair PRoot created.
+ *
+ * A record is dropped as soon as either name is gone or is no longer the very
+ * inode the emulation left behind, so a name later replaced by rename(2) --
+ * dpkg(1) rewrites its status file that way -- stops being reported the
+ * moment the pair stops being one file.  Only the byte copies are recorded: a
+ * symbolic source recreated as a symbolic destination is a pair of links to
+ * one target, which is what link(2) would have made of them anyway, and no
+ * tool asks a symlink how many links it has.
+ *
+ * Names are compared as the translation produced them, so two spellings of
+ * one host path (through a symlinked directory, say) are two keys and only the
+ * spelling the emulation saw is answered.  Names of PATH_MAX bytes or more are
+ * not recorded at all, and the table is a ring: the pair being asked about is
+ * the pair just made, so recency is the right thing to keep.
+ */
+#define EMLINK_MAX 16
+struct emulated_link {
+	char old_path[PATH_MAX];
+	char new_path[PATH_MAX];
+	ino_t old_ino;
+	dev_t old_dev;
+	ino_t new_ino;
+	dev_t new_dev;
+	bool used;
+};
+static struct emulated_link emulated_links[EMLINK_MAX];
+static unsigned int emulated_link_next;
+
+/**
+ * Record the byte copy @old_translated -> @new_translated that emulate_link()
+ * just made, with the identities of both names, so that a later stat(2) on
+ * either can be answered as a hard link's would be.
+ */
+static void record_emulated_link(const char *old_translated,
+		const char *new_translated, const struct stat *old_stat,
+		const struct stat *new_stat)
+{
+	struct emulated_link *link;
+
+	if (strlen(old_translated) >= PATH_MAX || strlen(new_translated) >= PATH_MAX)
+		return;
+
+	link = &emulated_links[emulated_link_next];
+	emulated_link_next = (emulated_link_next + 1) % EMLINK_MAX;
+
+	strcpy(link->old_path, old_translated);
+	strcpy(link->new_path, new_translated);
+	link->old_ino = old_stat->st_ino;
+	link->old_dev = old_stat->st_dev;
+	link->new_ino = new_stat->st_ino;
+	link->new_dev = new_stat->st_dev;
+	link->used = true;
+}
+
+/**
+ * Whether this record is still the pair the emulation made: both names there,
+ * each still the very inode it left behind.  A name that was unlinked, or
+ * replaced by rename(2), ends the pair -- and the record with it, so the table
+ * cannot answer for a file that is no longer the one it copied.
+ */
+static bool emulated_link_alive(struct emulated_link *link)
+{
+	struct stat sb;
+
+	if (lstat(link->old_path, &sb) != 0
+	    || sb.st_ino != link->old_ino || sb.st_dev != link->old_dev) {
+		link->used = false;
+		return false;
+	}
+	if (lstat(link->new_path, &sb) != 0
+	    || sb.st_ino != link->new_ino || sb.st_dev != link->new_dev) {
+		link->used = false;
+		return false;
+	}
+	return true;
+}
+
+/** Whether @path is one of the @nr names in @members.  */
+static bool is_member(const char *members[EMLINK_MAX + 1], unsigned int nr,
+		const char *path)
+{
+	unsigned int i;
+
+	for (i = 0; i < nr; i++)
+		if (strcmp(members[i], path) == 0)
+			return true;
+	return false;
+}
+
+/**
+ * What a hard link would have left for @host_path, when @host_path is one of
+ * the names of an emulated group: the inode all the names share, its device,
+ * and how many names refer to it.  Returns false when @host_path is none of
+ * them, which is the answer for every file the emulation never touched.
+ *
+ * The group is closed over transitively -- link(a, b) followed by link(b, c)
+ * is three names of one file, the third reached through the second -- and its
+ * inode is the one belonging to the name that existed before the first
+ * emulation, which is the inode a real hard link would have kept for all of
+ * them.
+ */
+static bool emulated_link_group(const char *host_path, ino_t *ino, dev_t *dev,
+		nlink_t *nlink)
+{
+	const char *members[EMLINK_MAX + 1];
+	bool seen[EMLINK_MAX] = {};
+	unsigned int nr_members = 1;
+	unsigned int nr_names = 1;
+	bool grew = true;
+	unsigned int i, j;
+
+	members[0] = host_path;
+
+	while (grew) {
+		grew = false;
+		for (i = 0; i < EMLINK_MAX; i++) {
+			struct emulated_link *link = &emulated_links[i];
+
+			/* The cheap screens come first: most records name
+			 * neither of the paths this walk has reached, and a
+			 * stat(2) of a file with no emulated link must not
+			 * pay for a lookup of every record.  */
+			if (!link->used || seen[i])
+				continue;
+			if (!is_member(members, nr_members, link->old_path)
+			    && !is_member(members, nr_members, link->new_path))
+				continue;
+			if (!emulated_link_alive(link))
+				continue;
+
+			seen[i] = true;
+			nr_names++;
+			if (!is_member(members, nr_members, link->old_path)
+			    && nr_members < EMLINK_MAX + 1)
+				members[nr_members++] = link->old_path;
+			if (!is_member(members, nr_members, link->new_path)
+			    && nr_members < EMLINK_MAX + 1)
+				members[nr_members++] = link->new_path;
+			grew = true;
+		}
+	}
+
+	if (nr_names == 1)
+		return false;
+
+	/* The name that is nobody's target came first: its inode is the one
+	 * every name of the group shares.  */
+	for (i = 0; i < EMLINK_MAX; i++) {
+		bool is_target = false;
+
+		if (!seen[i])
+			continue;
+		for (j = 0; j < EMLINK_MAX; j++)
+			if (seen[j]
+			    && strcmp(emulated_links[j].new_path,
+				      emulated_links[i].old_path) == 0)
+				is_target = true;
+		if (is_target)
+			continue;
+
+		*ino = emulated_links[i].old_ino;
+		*dev = emulated_links[i].old_dev;
+		*nlink = nr_names;
+		return true;
+	}
+
+	/* Every name is some record's target, which only a cycle could do and
+	 * the emulation cannot make one; the group is one file regardless.  */
+	for (i = 0; i < EMLINK_MAX; i++) {
+		if (!seen[i])
+			continue;
+		*ino = emulated_links[i].old_ino;
+		*dev = emulated_links[i].old_dev;
+		*nlink = nr_names;
+		return true;
+	}
+	return false;
+}
+
+/**
+ * Answer the guest's stat(2) on @host_path as the hard link it emulates would
+ * have been answered.  Called from the exit stage of every syscall; the switch
+ * on the syscall number is what keeps that from costing anything, and the
+ * group lookup that follows is a pair of string comparisons for a file with no
+ * emulated link.
+ *
+ * Only for a tracee whose ABI is PRoot's own.  The stat structure is read and
+ * written back whole rather than poked field by field at computed offsets, and
+ * a 32-bit tracee's structure -- PR_stat64 and PR_fstatat64 are its calls --
+ * is not the 64-bit one this reads and writes: doing it anyway would write
+ * past the guest's buffer and corrupt its memory.  fake_id0 pokes a field at a
+ * time for exactly this reason, and it can, because abi.h carries the offsets
+ * for the two fields it cares about; there are none for inode, device and link
+ * count, so a 32-bit tracee keeps the kernel's answer -- a byte copy with one
+ * link, which is what it would have got without this patch.  The statx(2)
+ * structure is ABI-independent, so fix_emulated_link_statx() needs no such
+ * guard.
+ *
+ * Best-effort by design.  This adds fidelity to a result the kernel already
+ * produced, so a failure here leaves the guest the kernel's answer -- a byte
+ * copy with one link -- rather than turning a successful stat(2) into a failed
+ * one.
+ */
+void fix_emulated_link_stat(Tracee *tracee, word_t syscall_number)
+{
+	Reg path_sysarg, stat_sysarg;
+	char host_path[PATH_MAX];
+	struct stat guest_stat;
+	ino_t ino;
+	dev_t dev;
+	nlink_t nlink;
+	word_t address;
+
+	/* Only a successful stat(2) has written a structure to patch.  */
+	if ((int) peek_reg(tracee, CURRENT, SYSARG_RESULT) != 0)
+		return;
+
+	/* A 32-bit tracee's structure is not the one read and written below.  */
+	if (is_32on64_mode(tracee))
+		return;
+
+	switch (syscall_number) {
+	case PR_stat:
+	case PR_stat64:
+	case PR_lstat:
+	case PR_lstat64:
+		path_sysarg = SYSARG_1;
+		stat_sysarg = SYSARG_2;
+		break;
+
+	case PR_fstatat64:
+	case PR_newfstatat:
+		path_sysarg = SYSARG_2;
+		stat_sysarg = SYSARG_3;
+		break;
+
+	default:
+		/* fstat(2) and fstat64(2) name no path, and there is
+		 * nothing to look an emulated link up by.  */
+		return;
+	}
+
+	/* The enter stage translated the path in place, so this is the host
+	 * path -- the key the emulation was recorded under.  */
+	if (get_sysarg_path(tracee, host_path, path_sysarg) <= 0)
+		return;
+
+	if (!emulated_link_group(host_path, &ino, &dev, &nlink))
+		return;
+
+	address = peek_reg(tracee, ORIGINAL, stat_sysarg);
+	if (read_data(tracee, &guest_stat, address, sizeof(guest_stat)) < 0)
+		return;
+
+	guest_stat.st_ino = ino;
+	guest_stat.st_dev = dev;
+	guest_stat.st_nlink = nlink;
+
+	write_data(tracee, address, &guest_stat, sizeof(guest_stat));
+}
+
+/**
+ * The statx(2) counterpart of fix_emulated_link_stat(), for the structure
+ * PRoot fills itself (see tracee/statx.c).  @state is corrected in place, and
+ * marked updated so that it is written back to the guest.
+ */
+void fix_emulated_link_statx(const char *host_path,
+		struct statx_syscall_state *state)
+{
+	ino_t ino;
+	dev_t dev;
+	nlink_t nlink;
+
+	if (!emulated_link_group(host_path, &ino, &dev, &nlink))
+		return;
+
+	if ((state->statx_buf.stx_mask & STATX_NLINK) != 0)
+		state->statx_buf.stx_nlink = nlink;
+	if ((state->statx_buf.stx_mask & STATX_INO) != 0)
+		state->statx_buf.stx_ino = ino;
+	state->statx_buf.stx_dev_major = major(dev);
+	state->statx_buf.stx_dev_minor = minor(dev);
+	state->updated_stats = true;
+}
+
 /**
  * Make @new_translated a hard link to @old_translated on behalf of the
  * tracee, and return 0 or a negative errno for the guest.  @flags is the
@@ -100,6 +404,7 @@ int emulate_link(Tracee *tracee, const char *old_translated,
 	char target[PATH_MAX];
 	int src_fd, dst_fd;
 	struct stat st;
+	struct stat dst_st;
 	char cpbuf[8192];
 	ssize_t n;
 	int saved;
@@ -174,8 +479,26 @@ int emulate_link(Tracee *tracee, const char *old_translated,
 		return -saved;
 	}
 
+	/* The copy has to answer for the link it stands in for, and that
+	 * needs the identity of the new name before the descriptor goes.  A
+	 * copy whose identity cannot be read is not the link the guest asked
+	 * for: undo it and report the failure, the way the copy itself is
+	 * undone above.  */
+	if (fstat(dst_fd, &dst_st) < 0) {
+		saved = errno;
+		close(dst_fd);
+		close(src_fd);
+		unlinkat(AT_FDCWD, new_translated, 0);
+		return -saved;
+	}
+
 	close(dst_fd);
 	close(src_fd);
+	record_emulated_link(old_translated, new_translated, &st, &dst_st);
+	link_diag("emulated link recorded: %s (ino %llu) <-> %s (ino %llu); "
+		"stat(2) on either now reports two links",
+		old_translated, (unsigned long long) st.st_ino,
+		new_translated, (unsigned long long) dst_st.st_ino);
 	VERBOSE(tracee, 3, "link: copied %s -> %s", old_translated, new_translated);
 	return 0;
 }
