index ca972f8..6431cda 100644
--- a/src/proot/src/tracee/statx.c
+++ b/src/proot/src/tracee/statx.c
@@ -3,6 +3,7 @@
 
 #include "tracee/statx.h"
 #include "tracee/mem.h"
+#include "tracee/seccomp.h"
 
 int handle_statx_syscall(Tracee *tracee, bool from_sigsys) {
 	RegVersion regVersion = from_sigsys ? CURRENT : ORIGINAL;
@@ -123,6 +124,12 @@ int handle_statx_syscall(Tracee *tracee, bool from_sigsys) {
