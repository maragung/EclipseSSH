-		int olddirfd = peek_reg(tracee, ORIGINAL, SYSARG_1);
-		int newdirfd = peek_reg(tracee, CURRENT, SYSARG_3);
-		int flags = peek_reg(tracee, CURRENT, SYSARG_5);
-		int size;
+		/* A rewritten link() arrives here after its own SIGSYS was
+		 * restored to the link() layout in CURRENT (SYSARG_1/2 =
+		 * old/new path), while a direct linkat() keeps the linkat
+		 * layout in CURRENT.  Android traps both syscalls, so both
+		 * flows must work.  */
+		int olddirfd, newdirfd, flags, size;
+		bool from_link_rewrite = tracee->link_rewrite_pending;
+		if (from_link_rewrite) {
+			tracee->link_rewrite_pending = false;
+			olddirfd = AT_FDCWD;
+			newdirfd = AT_FDCWD;
+			flags = 0;
+		} else {
+			olddirfd = peek_reg(tracee, CURRENT, SYSARG_1);
+			newdirfd = peek_reg(tracee, CURRENT, SYSARG_3);
+			flags = peek_reg(tracee, CURRENT, SYSARG_5);
+		}
 
