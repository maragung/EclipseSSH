 /**
+ * Append one diagnostic line to the blocked-syscall log (the file named by
+ * PROOT_SIGSYS_LOG, defaulting to the fork's own app cache; an empty value
+ * disables it).
+ *
+ * The link emulation is the one place where PRoot itself invents the errno
+ * the guest sees, and the device failure this log exists for was a bare
+ * "Permission denied" from dpkg's status-db backup with nothing to say
+ * which step produced it: the trap, the path translation, the platform's
+ * hard-link attempt, or the byte copy.  Every decision is named here, so
+ * the answer arrives with the next run instead of the next theory.
+ */
+static void link_diag(const char *fmt, ...)
+{
+	char line[512];
+	va_list ap;
+	const char *log_path = getenv("PROOT_SIGSYS_LOG");
+	FILE *f;
+
+	va_start(ap, fmt);
+	vsnprintf(line, sizeof(line), fmt, ap);
+	va_end(ap);
+
+	if (log_path == NULL)
+		log_path = "/data/data/id.or.oo.pr/cache/sigsys-log.txt";
+	if (*log_path == '\0')
+		return;
+
+	f = fopen(log_path, "a");
+	if (f == NULL)
+		return;
+	fprintf(f, "LINK: %s\n", line);
+	fclose(f);
+}
