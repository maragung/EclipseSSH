 		poke_reg(tracee, SYSARG_3, AT_FDCWD);
 		poke_reg(tracee, SYSARG_5, 0);
+		/* Android traps linkat too, so this rewrite SIGSYSes again.
+		 * Flag it so the PR_linkat emulation knows the register
+		 * banks hold the link() layout when that second trap lands.  */
+		tracee->link_rewrite_pending = true;
 		restart_syscall_after_seccomp(tracee);
 		break;
 
@@ -664,17 +668,36 @@
