+/**
+ * Make @new_translated a hard link to @old_translated on behalf of the
+ * tracee, and return 0 or a negative errno for the guest.  @flags is the
+ * guest's linkat(2) flags; link(2) has none.  The work happens in PRoot's
+ * own process, on the already-translated host paths, exactly like the path
+ * translations PRoot performs everywhere else.
+ *
+ * The real linkat(2) is tried first, so wherever the platform permits hard
+ * links the guest keeps hard-link semantics: one inode, one copy of the
+ * data, and -- for a symbolic source -- a second name for the link itself
+ * rather than a second link.  Android permits none of that: SELinux denies
+ * file:link in app data with EACCES and a dontaudit rule, so the kernel
+ * refuses and says nothing.  dpkg(1) makes its /var/lib/dpkg/status backup
+ * with link(status, status-old) and cannot install anything without it, so
+ * the refusals are emulated instead:
+ *
+ *   - a symbolic source that is not to be followed becomes a symbolic
+ *     destination with the same target, since a byte copy cannot express
+ *     "a second name for this link" (opening it with O_NOFOLLOW is ELOOP);
+ *   - anything else is byte-copied: same content, same mode, source kept.
+ *
+ * O_CREAT|O_EXCL reproduces link(2)'s EEXIST for an existing target, and a
+ * failed copy is removed again with unlinkat(2).
+ *
+ * Every syscall in here is made by PRoot's own process, which runs under
+ * the app seccomp policy just like its tracees do: it may only use the
+ * syscalls that policy allows (bionic's SYSCALLS.TXT lists linkat,
+ * readlinkat, symlinkat, unlinkat, openat, fstat, read, write and close,
+ * and neither app blocklist removes any of them), because a trapped syscall
+ * kills the process -- SIG_IGN does not save it.  link(2) and unlink(2) are
+ * not on that list, which is why neither one appears here.
+ */
+int emulate_link(Tracee *tracee, const char *old_translated,
+			const char *new_translated, int flags)
+{
+	char target[PATH_MAX];
+	int src_fd, dst_fd;
+	struct stat st;
+	char cpbuf[8192];
+	ssize_t n;
+	int saved;
+
+	if (linkat(AT_FDCWD, old_translated, AT_FDCWD, new_translated,
+		   flags & AT_SYMLINK_FOLLOW) == 0)
+		return 0;
+
+	/* Distinguish "the kernel refused" from "nothing ran": a syscall
+	 * that never executed leaves errno untouched.  */
+	saved = errno != 0 ? errno : ENOSYS;
+	if (saved != EACCES && saved != EPERM && saved != EXDEV
+	    && saved != ENOSYS && saved != EOPNOTSUPP)
+		return -saved;	/* EEXIST, ENOENT, EISDIR, ... are the answer */
+
+	link_diag("native linkat refused (%d), emulating: %s -> %s",
+		saved, old_translated, new_translated);
+	VERBOSE(tracee, 3, "link: native linkat refused (%d), emulating: %s -> %s",
+		saved, old_translated, new_translated);
+
+	if ((flags & AT_SYMLINK_FOLLOW) == 0) {
+		n = readlinkat(AT_FDCWD, old_translated, target, sizeof(target) - 1);
+		if (n >= 0) {
+			target[n] = '\0';
+			link_diag("symbolic source, recreating target: %s -> %s (%s)",
+				old_translated, new_translated, target);
+			if (symlinkat(target, AT_FDCWD, new_translated) == 0)
+				return 0;
+			return -errno;
+		}
+	}
+
+	src_fd = open(old_translated,
+		      O_RDONLY | (((flags & AT_SYMLINK_FOLLOW) != 0) ? 0 : O_NOFOLLOW));
+	if (src_fd < 0)
+		return -errno;
+
+	if (fstat(src_fd, &st) < 0) {
+		saved = errno;
+		close(src_fd);
+		return -saved;
+	}
+
+	dst_fd = open(new_translated, O_WRONLY | O_CREAT | O_EXCL, st.st_mode & 07777);
+	if (dst_fd < 0) {
+		saved = errno;
+		close(src_fd);
+		return -saved;
+	}
+
+	while ((n = read(src_fd, cpbuf, sizeof(cpbuf))) > 0) {
+		ssize_t written = 0;
+
+		while (written < n) {
+			ssize_t w = write(dst_fd, cpbuf + written, n - written);
+
+			if (w < 0) {
+				saved = errno;
+				close(dst_fd);
+				close(src_fd);
+				unlinkat(AT_FDCWD, new_translated, 0);
+				return -saved;
+			}
+			written += w;
+		}
+	}
+	if (n < 0) {
+		saved = errno;
+		close(dst_fd);
+		close(src_fd);
+		unlinkat(AT_FDCWD, new_translated, 0);
+		return -saved;
+	}
+
+	close(dst_fd);
+	close(src_fd);
+	VERBOSE(tracee, 3, "link: copied %s -> %s", old_translated, new_translated);
+	return 0;
+}
