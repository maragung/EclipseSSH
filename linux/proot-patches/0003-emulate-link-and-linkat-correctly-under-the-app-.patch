+				                  : peek_reg(tracee, CURRENT, SYSARG_2),
+				PATH_MAX);
 		if (size < 0) {
 			set_result_after_seccomp(tracee, size);
 			break;
 		}
-		size = read_string(tracee, newpath, peek_reg(tracee, CURRENT, SYSARG_4), PATH_MAX);
+		size = read_string(tracee, newpath,
+				from_link_rewrite ? peek_reg(tracee, CURRENT, SYSARG_2)
+				                  : peek_reg(tracee, CURRENT, SYSARG_4),
+				PATH_MAX);
 		if (size < 0) {
 			set_result_after_seccomp(tracee, size);
 			break;
@@ -691,21 +714,34 @@
 			break;
 		}
 
+		/* The kernel runs this code under the same seccomp filter
+		 * that trapped linkat, so the host link() would SIGSYS-kill
+		 * proot itself; a byte copy is the only emulation that can
+		 * run.  The old code called renameat() and unlinked the
+		 * source - that moved the file instead of hardlinking it,
