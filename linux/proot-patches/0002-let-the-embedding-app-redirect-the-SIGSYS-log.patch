 #include <sched.h>     /* CLONE_*, */
 #include <limits.h>    /* PATH_MAX, */
+#include <stdlib.h>   /* getenv(3), */
 
 #include "extension/extension.h"
 #include "cli/note.h"
@@ -837,8 +838,15 @@
 	default:
 	{
 		word_t kernel_num = peek_reg(tracee, CURRENT, SYSARG_NUM);
-		const char *log_path = "/data/data/id.or.oo.pr/cache/sigsys-log.txt";
-		FILE *f = fopen(log_path, "a");
+		/* The default log path belongs to the fork's own app and is
+		 * unwritable for any other embedding app, which silently
+		 * disables this diagnostic. PROOT_SIGSYS_LOG lets the embedding
+		 * app redirect it (a path it can write); an empty value
+		 * disables the file logging entirely.  */
+		const char *log_path = getenv("PROOT_SIGSYS_LOG");
+		if (log_path == NULL)
+			log_path = "/data/data/id.or.oo.pr/cache/sigsys-log.txt";
+		FILE *f = (*log_path != '\0') ? fopen(log_path, "a") : NULL;
