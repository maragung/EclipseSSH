<resources>
    <string name="app_name">Eclipse SSH</string>
    <string name="widget_description">Quick launch Eclipse SSH sessions and transfers</string>
    <string name="widget_subtitle">Tap to open terminals &amp; SFTP</string>
    <string name="widget_open_description">Open Eclipse SSH</string>
    <string name="service_description">Keeps SSH sessions and SFTP transfers running in the background.</string>

    <!-- Notification channels -->
    <string name="channel_sessions">Active sessions</string>
    <string name="channel_sessions_desc">Ongoing SSH sessions, port forwards and transfers</string>
    <string name="channel_transfers">Transfer progress</string>
    <string name="channel_transfers_desc">Progress and results of SFTP uploads and downloads</string>
    <string name="channel_alerts">Alerts</string>
    <string name="channel_alerts_desc">Disconnects, host key changes and failed transfers</string>
    <string name="channel_linux">Local Linux</string>
    <string name="channel_linux_desc">The local Ubuntu environment and its terminals</string>

    <!-- Notification content -->
    <string name="notif_action_disconnect">Disconnect all</string>
    <string name="notif_action_reconnect">Reconnect</string>
    <string name="notif_linux_title">Local Ubuntu 22.04</string>
    <string name="notif_linux_body">Running on this device · %1$d terminal session(s) held open</string>
    <string name="notif_linux_action_open">Open</string>
    <string name="notif_linux_action_stop">Stop Ubuntu</string>

    <!-- The platform refused to promote the Ubuntu hold service (Android 12+ forbids background starts) -->
    <string name="notif_linux_promotion_title">Ubuntu runs only while the app is open</string>
    <string name="notif_linux_promotion_body">Android would not let Eclipse SSH hold your local Ubuntu environment open in the background. It keeps running while the app is on screen — open Eclipse SSH if you need the terminals held open.</string>

    <!-- Foreground-service time limit (Android 15 caps dataSync services at 6h/24h) -->
    <string name="notif_timeout_title">Background sessions paused</string>
    <string name="notif_timeout_body">Android limits background syncing to six hours a day, so Eclipse SSH can no longer hold your sessions open in the background. They keep working while the app is on screen — open it now if you need them, or they may be dropped once Android reclaims the app.</string>

    <!-- The session service was recycled with sessions still live: they lost background protection, not their connection -->
    <string name="notif_detached_title">Sessions without background protection</string>
    <string name="notif_detached_body">Android stopped the background service, so your sessions keep working only while Eclipse SSH is on screen. Open the app now if you need them held open.</string>

    <!-- Restore-after-restart prompt (Android 12+ forbids starting this service from the background) -->
    <string name="notif_restore_title">Reconnect your sessions</string>
    <string name="notif_restore_body">Eclipse SSH cannot reconnect on its own after a restart. Tap to restore your sessions and resume transfers.</string>

    <!--
        System biometric sheet. These are the app's only user-facing strings that Android itself
        draws, so they cannot be Compose literals like the in-app text is: BiometricPrompt is handed
        finished CharSequences. See BiometricUnlocker.

        The rest of this file's screen text was a second, stale copy of what the composables say.
        Twenty of those entries were unreferenced and most had drifted from the wording actually on
        screen: "Accept and save" against a button reading "Trust and connect", a lock subtitle about
        an encrypted vault against a screen that asks for a PIN. Wiring those up would have silently
        rewritten the UI, and keeping them left a trap for whoever wired them up next, so they were
        removed instead. The in-app text is still English literals in the composables; localising it
        is a separate change that has to touch every call site, not something to fake with resources
        nothing reads.
    -->
    <string name="lock_biometric_title">Unlock Eclipse SSH</string>
    <string name="lock_biometric_subtitle">Use your biometric or device credential</string>
    <string name="lock_biometric_subtitle_no_credential">Use your fingerprint or face to continue</string>
    <string name="lock_use_pin">Use PIN</string>
    <string name="lock_auth_failed">Authentication failed</string>
    <string name="lock_biometric_unavailable">Biometric prompt unavailable</string>
    <string name="lock_biometric_no_hardware">This device has no biometric sensor</string>
    <string name="lock_biometric_hw_unavailable">The biometric sensor is busy or unavailable</string>
    <string name="lock_biometric_none_enrolled">No fingerprint or face is enrolled on this device</string>
    <string name="lock_biometric_update_required">A security update is required before biometrics can be used</string>

    <!-- Quick Settings tile -->
    <string name="qstile_label">Eclipse SSH — connect to last host</string>

    <!-- Widget subtitle (with a connected host name) -->
    <string name="widget_subtitle_with_host">Tap to connect to %1$s</string>
</resources>
