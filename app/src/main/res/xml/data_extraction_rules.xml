<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup is disabled app-wide (allowBackup=false) because the vault key
  lives in the Android Keystore and cannot leave the device: a restored
  database would be undecryptable. Use Settings -> Export encrypted vault
  for device-to-device migration instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
