<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Keeping SSH sessions / SFTP transfers alive while minimised or locked -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Biometric vault unlock. USE_BIOMETRIC is normal-level: no runtime prompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      No READ/WRITE_EXTERNAL_STORAGE and no MANAGE_EXTERNAL_STORAGE by design.
      All local file access goes through the Storage Access Framework
      (ACTION_OPEN_DOCUMENT / ACTION_CREATE_DOCUMENT / OPEN_DOCUMENT_TREE).
    -->

    <application
        android:name=".EclipseApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EclipseSSH"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.EclipseSSH.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ssh://user@host:port deep links -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ssh" />
                <data android:scheme="sftp" />
            </intent-filter>

            <!--
              Receive shared text (host config snippet, a public key, a
              hostname to connect to). The activity reads the
              EXTRA_STREAM / EXTRA_TEXT and routes it to the right
              surface: a host key into the keys list, a hostname into
              the Add Host form, a command into the terminal.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!--
          The text editor, in its own window so it reads as an editor rather
          than as a panel over the app: launched on top of MainActivity by the
          Files explorer, the file preview and the New File dialog. Not
          exported — it is only ever started from inside the app, and its one
          extra is a token into an in-process handoff (EditorRequests), not a
          path or a URI anyone else could name.
        -->
        <activity
            android:name=".ui.editor.TextEditorActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!--
          The remote desktop viewer, in its own window for the same reasons
          as the editor above - and for two more of its own: an immersive
          fullscreen with no chrome to tap by accident, and an orientation
          the user can lock from the viewer's toolbar without dragging the
          terminal behind it along. The same configChanges list as the
          editor so a rotation is a recomposition, not a relaunch: the
          viewer owns a live tunnel an intent cannot parcel, and its
          handoff token is single-shot by design. Not exported - it is only
          ever started from inside the app.
        -->
        <activity
            android:name=".ui.remotedesktop.RemoteDesktopActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!--
          About, promoted from a dialog over Settings to a window of its own.
          It carries the app's longest piece of reading - the licence list -
          which a height-capped dialog body could only letterbox, and whose
          rows below the fold it could not reach. No configChanges list, unlike
          the two above: this screen holds no live state to protect, so a
          rotation recreating it costs one static composition and nothing else.
          Not exported - it is only ever started from Settings.
        -->
        <activity
            android:name=".ui.about.AboutActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!--
          The six Settings rows that used to open an AlertDialog of choices, promoted
          to windows of their own. Unlike About they are all started from Settings
          and all edit one number in the settings DataStore, so they share one base
          class and differ only in their title, icon, choices and setter. No
          configChanges list for the same reason About has none: each holds a single
          number in local state, and a rotation that recreates it costs one read of
          the store. Not exported - Settings is the only caller.
        -->
        <activity
            android:name=".ui.settings.KeepAliveActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.settings.ClipboardClearActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.settings.ReconnectDelayActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.settings.VaultAutoLockActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.settings.TerminalWidthActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.settings.TerminalHeightActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <!--
          The Add-forward form. Reached from the Settings list rather than from a Settings row of its
          own, so it sits beside the settings destinations rather than among them: it edits no
          setting, and the forward it produces is handed back to the workspace's view model rather
          than written to a store - see ForwardRequests.
        -->
        <activity
            android:name=".ui.forward.ForwardFormActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!--
          The two previews, promoted from `ModalBottomSheet`s over the workspace to windows of
          their own. Both carry the editor's `configChanges` list, and here it is load-bearing
          rather than a habit: what each one shows arrives through a one-shot token
          (PreviewRequests) because a live FileSystemProvider, or a closure over an open archive,
          cannot be parcelled - so a rotation that recreated either window would find its token
          spent and close itself. A preview that vanishes when the phone turns is the one failure
          this pair must not have. singleTop for the same reason the editor has it: opening a
          second file while a preview is on screen replaces its subject instead of stacking a
          window per file the user glances at.
          Not exported - they are only ever started from inside the app, and their one extra is a
          token into an in-process handoff rather than a path or a URI anyone else could name.
        -->
        <activity
            android:name=".ui.preview.FilePreviewActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.archive.ArchiveEntryPreviewActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />

        <!--
          The transfers window: everything one transfer can do, in a window of its own
          rather than a sheet over the progress row it acts on. Its subject is a plain
          id read back from TransferRepository, so - unlike the token-carrying windows
          above - it does not need singleTop: a second launch is a different transfer
          and correctly a different instance. The configChanges list is only so a
          rotation is a recomposition; nothing breaks if this activity is recreated.
        -->
        <activity
            android:name=".ui.transfers.TransferActionsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!--
          The session "why?" window: the reason a session is in the state it is, and
          the diagnostic trace still being written for it. Its subject is a SessionTab,
          which this app cannot parcel, so it travels through the same in-process
          token handoff (ActionRequests) the editor and the previews use - hence
          singleTop and the configChanges list, both of which are load-bearing here:
          a re-delivered intent finds its token spent and closes itself.
        -->
        <activity
            android:name=".ui.sessions.SessionWhyActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />

        <!--
          The archive entry window: everything one entry inside an archive can do, in a
          window of its own rather than a sheet over the listing it was chosen from.
          Like the session and explorer windows below it, its subject is a row of a
          tree this app cannot parcel, so it travels through the ActionRequests token
          handoff - hence singleTop and the configChanges list, both load-bearing: a
          re-delivered intent finds its token spent and closes itself.
        -->
        <activity
            android:name=".ui.archive.ArchiveEntryActionsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />

        <!--
          The explorer's per-entry window: everything one file or folder can do. Its
          subject is an FsEntry - a row of a listing the explorer's controller holds,
          which no intent can carry - so it uses the same token handoff, with the
          session's own facts (local, permissions, archive-readable) as plain boolean
          extras, because booleans do parcel.
        -->
        <activity
            android:name=".ui.files.FileActionsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />

        <!--
          The snippets window: the saved commands, over the terminal they will be
          typed into rather than a sheet covering it. It is the one window here with
          no subject at all - the list is SnippetRepository, a singleton this activity
          injects and watches - so nothing is carried and nothing is spent; singleTop
          is the ordinary "one snippets window" rule rather than a token requirement.
        -->
        <activity
            android:name=".ui.snippets.SnippetsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />

        <!--
          One host's port-forwarding rules: the list itself, what each rule is doing, and
          the controls that change either. Its subject is a token (ActionRequests)
          carrying the host's id plus a snapshot of the runtime half, which the
          workspace owns; the saved rules are read live from HostRepository by that id,
          which is what makes the window's own saves appear in its own list. Token
          window, so singleTop and the configChanges list are load-bearing rather than
          habitual: a re-delivered intent finds its token spent and closes itself.
        -->
        <activity
            android:name=".ui.forward.PortForwardManagerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />

        <!--
          One host's details: how it is reached, what is remembered for it, what it is
          doing. A token window for the same reason as the manager above it - the host
          and its saved credentials are read live by id, but the server-stats snapshot
          is the workspace's and an intent cannot carry one. Same singleTop and
          configChanges, for the same reason.
        -->
        <activity
            android:name=".ui.hosts.HostDetailsActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />

        <!--
          Terminal font size, the one Settings row whose value is a range rather than a
          menu of choices - hence its own Activity rather than the shared choice base,
          and its own entry rather than a comment on the block above.
        -->
        <activity
            android:name=".ui.settings.TerminalFontSizeActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!--
          The three security rows: which host keys are trusted, which hosts have a secret in
          the vault, and the PIN that locks it. Unlike the seven above they share no base beyond
          the window itself - each reaches a different store (the known-hosts file, the
          credential store plus the session registry, the settings DataStore) and each owns the
          report of its own failed write, so there is nothing left for a common shape to hold.
          Same reasoning on configChanges as the rest: local state, one read of a store, and a
          rotation is cheaper than the configChanges list. Not exported - Settings is the only
          caller.
        -->
        <activity
            android:name=".ui.settings.KnownHostsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.settings.SavedCredentialsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.settings.PinLockActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!--
          The five heavy rows, which needed more than a body: each of these opened a dialog
          that either could not fit what it had to show, or had to own work the Settings list
          had no room to hold.

          They are one block rather than five comments because what separates them from the
          ten above is a single fact: every one of them drives something that outlives the
          window. A generated key pair and an exported backup each pick a destination and
          write it; the shortcut bar edits a stored blob and can be left unsaved; diagnostics
          reads a ring buffer the session keeps; the Ubuntu section starts and stops a real
          userspace. The ten above read one value from a store and write it back.

          That is also why each of these holds [VaultUnlockGate] across its SAF picker. A
          picker is another app's activity, so the process reports itself backgrounded while
          one is up, and the auto-lock observer would otherwise start the re-lock countdown
          over a window the user is still working in.

          No configChanges list, same reasoning as the rest: each of them re-reads its store
          on creation, so a rotation costs one read. Not exported - Settings is the only
          caller.
        -->
        <activity
            android:name=".ui.settings.ShortcutBarActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.settings.DiagnosticsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.settings.KeyGenActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.settings.ExportBackupActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ui.settings.UbuntuActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!--
          The Add / Edit host form, and the one entry in this file that Settings does not
          open. It is reached from the Hosts list - the Add button, a card's Edit item, and
          the "Edit host" action on the failed-login prompt - so the comment above about
          Settings being the only caller does not cover it.

          It is here rather than beside the Hosts list's own declarations because everything
          about the window is shared with the sixteen above it: same shell, same chrome, same
          back arrow. What differs is the subject - a host, not a preference - and that it
          reads the host it was opened for out of the intent.

          adjustResize is the one attribute none of the sixteen carry, and it is here because
          of what this screen is: a full page of text fields down to a Save button at the
          bottom. Without it the IME covers the fields it is being typed into and the last
          section of the form. The others either have no text input at all or take it in a
          single field near the top.

          The configChanges list is the other attribute none of the sixteen carry, and it is
          here for a stronger reason than adjustResize. Their reasoning does not reach this
          screen: they hold a value that lives in a store, so a rotation costs one read and
          loses nothing. This one holds *unsaved user input* - a name, a hostname, a
          passphrase, a picked key file, fourteen engine settings - and a rotation that
          recreated it would silently discard all of it, which is data loss rather than a
          cheap re-read. The alternatives were worse: `rememberSaveable` on the fields would
          write the form into a Bundle, and a Bundle is persisted to disk by the system and
          is not a place for a passphrase or a private key's bytes to end up. Not recreating
          the window is the same choice MainActivity makes for the workspace, and for the
          same reason.

          It holds [VaultUnlockGate] across its key picker for the same reason the block
          above does, and it is the one screen where that matters most: the passphrase for the
          key being attached is typed after the picker returns, and a re-lock over that field
          would discard it.
        -->
        <activity
            android:name=".ui.settings.HostFormActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!--
          Long-lived work host: terminal shells, SFTP transfers and port
          forwards all run inside this service so that the process survives
          minimise / screen-off. dataSync is the correct FGS type for
          user-initiated network transfer work.
        -->
        <service
            android:name=".background.EclipseSessionService"
            android:description="@string/service_description"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!--
          Process-liveness hold for the local Ubuntu userspace: every
          forked proot shell is a child of this process, so "background
          does not stop Ubuntu" is a process-liveness promise. Started and
          stopped by the userspace state machine via
          LinuxUserspaceController (never requested directly), dataSync
          matching the session service's type since the two share one
          six-hour-per-day budget on Android 15.
        -->
        <service
            android:name=".background.LinuxUserspaceService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />

        <!--
          WorkManager is initialised on demand through Hilt
          (EclipseApp implements Configuration.Provider).
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <receiver
            android:name=".background.BootRestoreReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.QuickConnectWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_connect_widget_info" />
        </receiver>

        <!--
          Quick Settings tile. Tapping the tile opens MainActivity with
          the EXTRA_QUICK_CONNECT_LAST extra, which the activity turns
          into a connect-to-most-recently-used-host action.

          android.service.quicksettings.activatable is the API 24+ signal
          that the tile is enabled for the user to add.
        -->
        <service
            android:name=".feature.qstile.QuickConnectTileService"
            android:exported="true"
            android:label="@string/qstile_label"
            android:icon="@mipmap/ic_launcher"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
